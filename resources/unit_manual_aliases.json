{
  "_comment": "Manual surface form -> canonical UCUM code aliases for unit strings that do not merge automatically through ucum.csv, the PCORnet UNIT value set and CDISC codelist C71620. Keys are observed strings (case-sensitive). Targets were checked against LOINC's EXAMPLE_UCUM_UNITS; those not in ucum.csv are UCUM annotation forms that LOINC uses (e.g. [beth'U], {INR}, mL/min/{1.73_m2}), for which prep/4.3 creates canonical entries with is_ucum=false.",
  "aliases": {
    "K/uL": "10*3/uL",
    "#/uL": "/uL",
    "U/g/Hb": "U/g{Hb}",
    "log10 cop/mL": "{Log_copies}/mL",
    "log copies/mL": "{Log_copies}/mL",
    "log IU/mL": "{Log_IU}/mL",
    "mg/24hr": "mg/(24.h)",
    "mg/24 H": "mg/(24.h)",
    "ng/mL DDU": "ng/mL{DDU}",
    "MPL": "[MPL'U]",
    "GPL": "[GPL'U]",
    "Bethesda Units": "[beth'U]",
    "cells/uL": "{cells}/uL",
    "deg C": "Cel",
    "mcmol/L": "umol/L",
    "mcmol/dL": "umol/dL",
    "mcU/mL": "uU/mL",
    "mg/g creatinine": "mg/g{creat}",
    "mL/min/1.73 sq m": "mL/min/{1.73_m2}",
    "mOsmol/kg": "mosm/kg",
    "mOsm/kg water": "mosm/kg{H2O}",
    "mmol/kg H2O": "mmol/kg{H2O}",
    "Thous IU/mL": "10*3.[IU]/mL",
    "Thous mIU/mL": "10*3.m[IU]/mL",
    "units/L": "[IU]/L",
    "units/mL": "[IU]/mL",
    "L/min m2": "L/min/m2",
    "arb U/L": "[arb'U]/L",
    "EIA units": "{EIA_index}",
    "Index": "{Index_val}",
    "INR": "{INR}",
    "Score": "{score}",
    "REV": "{REV}",
    "LIV": "{LIV}",
    "10-9 mol/L": "nmol/L",
    "kEU/L": "k[EU]/L",
    "L/m": "L/min",
    "{Spec grav}": "{Spec grav}"
  },
  "exclude": [
    "N/A",
    "+/-"
  ]
}
